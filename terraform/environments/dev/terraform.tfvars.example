aws_region = "us-east-1"

project_name = "aegis"
environment  = "dev"
owner_name = "Oryan"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidr   = "10.0.1.0/24"
database_subnet_cidr = "10.0.10.0/24"
redis_subnet_cidr    = "10.0.20.0/24"

allowed_admin_cidr = "YOUR_PUBLIC_IP/32"

app_instance_type      = "t3.small"
database_instance_type = "t3.small"
redis_instance_type    = "t3.small"

ssh_public_key_path = "~/.ssh/YOUR_PUBLIC_KEY.pub"